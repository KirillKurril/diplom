<mxfile host="app.diagrams.net" modified="2025-11-27T00:00:00Z" agent="ChatGPT" version="24.7.0" editor="draw.io">
  <diagram id="alg-form-test" name="Алгоритм формирования теста">
    <mxGraphModel dx="1062" dy="595" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Start -->
        <mxCell id="2" value="Начало" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="20" width="120" height="40" as="geometry"/>
        </mxCell>

        <!-- Input parameters -->
        <mxCell id="3" value="Ввод параметров теста&#xa;(предмет, темы, сложность,&#xa;кол-во вопросов)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="90" width="260" height="70" as="geometry"/>
        </mxCell>

        <!-- Select tasks from DB -->
        <mxCell id="4" value="Выбор заданий из банка&#xa;по заданным параметрам" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="180" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- Decision: enough tasks? -->
        <mxCell id="5" value="Достаточно подходящих&#xa;заданий?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="115" y="260" width="210" height="80" as="geometry"/>
        </mxCell>

        <!-- Error: not enough tasks -->
        <mxCell id="6" value="Сообщить об ошибке&#xa;&quot;Недостаточно заданий&quot;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="260" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- End after error -->
        <mxCell id="7" value="Конец" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="360" width="100" height="40" as="geometry"/>
        </mxCell>

        <!-- Random selection -->
        <mxCell id="8" value="Случайный выбор заданий&#xa;с учётом квот и без повторов" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="360" width="260" height="70" as="geometry"/>
        </mxCell>

        <!-- Save test -->
        <mxCell id="9" value="Сохранить тест и его состав&#xa;в базе данных (статус: черновик)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="450" width="260" height="70" as="geometry"/>
        </mxCell>

        <!-- Decision: publish? -->
        <mxCell id="10" value="Преподаватель&#xa;публикует тест?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="115" y="540" width="210" height="80" as="geometry"/>
        </mxCell>

        <!-- Publish test -->
        <mxCell id="11" value="Пометить тест как опубликованный&#xa;и сделать доступным для назначений" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="640" width="260" height="80" as="geometry"/>
        </mxCell>

        <!-- Final end -->
        <mxCell id="12" value="Конец" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="750" width="120" height="40" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="20" edge="1" parent="1" source="2" target="3" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="21" edge="1" parent="1" source="3" target="4" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="22" edge="1" parent="1" source="4" target="5" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Yes: enough tasks -->
        <mxCell id="23" value="Да" edge="1" parent="1" source="5" target="8" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="340" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <!-- No: not enough tasks -->
        <mxCell id="24" value="Нет" edge="1" parent="1" source="5" target="6" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="295" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="25" edge="1" parent="1" source="6" target="7" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="26" edge="1" parent="1" source="8" target="9" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="27" edge="1" parent="1" source="9" target="10" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Yes: publish -->
        <mxCell id="28" value="Да" edge="1" parent="1" source="10" target="11" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- No: leave draft, go to end -->
        <mxCell id="29" value="Нет" edge="1" parent="1" source="10" target="12" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="760" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="30" edge="1" parent="1" source="11" target="12" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="alg-process-results" name="Алгоритм обработки результатов теста">
    <mxGraphModel dx="1062" dy="595" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Start -->
        <mxCell id="102" value="Начало" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="20" width="120" height="40" as="geometry"/>
        </mxCell>

        <!-- Create attempt -->
        <mxCell id="103" value="Создать запись о попытке&#xa;тестирования в базе данных" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="90" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- Next question -->
        <mxCell id="104" value="Получить очередной ответ&#xa;пользователя" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="170" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- Decision: more questions? -->
        <mxCell id="105" value="Есть ещё вопросы&#xa;в тесте?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="115" y="250" width="210" height="80" as="geometry"/>
        </mxCell>

        <!-- Save answer and check -->
        <mxCell id="106" value="Сохранить ответ в таблице&#xa;user_answer и проверить&#xa;корректность" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="350" width="260" height="80" as="geometry"/>
        </mxCell>

        <!-- Compute scores -->
        <mxCell id="107" value="Вычислить сырые баллы,&#xa;процент правильных ответов&#xa;и длительность попытки" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="460" width="260" height="80" as="geometry"/>
        </mxCell>

        <!-- Save attempt summary -->
        <mxCell id="108" value="Обновить запись попытки&#xa;(баллы, процент, статус=finished)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="560" width="260" height="70" as="geometry"/>
        </mxCell>

        <!-- Notify / pass to analytics -->
        <mxCell id="109" value="Передать результаты&#xa;для аналитики и преподавателю" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="650" width="260" height="70" as="geometry"/>
        </mxCell>

        <!-- End -->
        <mxCell id="110" value="Конец" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="750" width="120" height="40" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="120" edge="1" parent="1" source="102" target="103" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="121" edge="1" parent="1" source="103" target="104" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="122" edge="1" parent="1" source="104" target="105" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Yes: there are questions -> save answer & go back -->
        <mxCell id="123" value="Да" edge="1" parent="1" source="105" target="106" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="124" edge="1" parent="1" source="106" target="104" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- No: no more questions -->
        <mxCell id="125" value="Нет" edge="1" parent="1" source="105" target="107" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="470" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="126" edge="1" parent="1" source="107" target="108" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="127" edge="1" parent="1" source="108" target="109" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="128" edge="1" parent="1" source="109" target="110" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.0.3 Chrome/140.0.7339.249 Electron/38.7.0 Safari/537.36" version="29.0.3" pages="2">
  <diagram id="alg-form-test" name="Алгоритм формирования теста">
    <mxGraphModel dx="1213" dy="899" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="3" value="Ввод параметров теста&#xa;(предмет, темы, сложность,&#xa;кол-во вопросов)" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="160" y="250" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Выбор заданий из банка&#xa;по заданным параметрам" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="160" y="340" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Достаточно подходящих&#xa;заданий?" style="rhombus;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="185" y="420" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Сообщить об ошибке&#xa;&quot;Недостаточно заданий&quot;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="500" y="420" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="8" value="Случайный выбор заданий&#xa;с учётом квот и без повторов" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="160" y="520" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="9" value="Сохранить тест и его состав&#xa;в базе данных (статус: черновик)" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="160" y="610" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="10" value="Преподаватель&#xa;публикует тест?" style="rhombus;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="185" y="700" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="11" value="Пометить тест как опубликованный&#xa;и сделать доступным для назначений" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="160" y="890" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="20" style="endArrow=block;html=1;" parent="1" target="3" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="220" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="21" style="endArrow=block;html=1;" parent="1" source="3" target="4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="22" style="endArrow=block;html=1;" parent="1" source="4" target="5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="23" value="Да" style="endArrow=block;html=1;" parent="1" source="5" target="8" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="24" value="Нет" style="endArrow=block;html=1;" parent="1" source="5" target="6" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="490" y="455" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="25" style="endArrow=block;html=1;" parent="1" source="6" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="610" y="910" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="26" style="endArrow=block;html=1;" parent="1" source="8" target="9" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="27" style="endArrow=block;html=1;" parent="1" source="9" target="10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="28" value="Да" style="endArrow=block;html=1;" parent="1" source="10" target="11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="29" value="Нет" style="endArrow=block;html=1;rounded=0;curved=0;" parent="1" source="10" edge="1">
          <mxGeometry x="-0.5065" relative="1" as="geometry">
            <mxPoint x="610" y="910" as="targetPoint" />
            <Array as="points">
              <mxPoint x="610" y="740" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="-GAoAW9Z5Y1-49vEYxgj-30" value="Начало" style="strokeWidth=1;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="240" y="180" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="-GAoAW9Z5Y1-49vEYxgj-31" value="Конец" style="strokeWidth=1;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="560" y="910" width="100" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="alg-process-results" name="Алгоритм обработки результатов теста">
    <mxGraphModel dx="1062" dy="595" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Start -->
        <mxCell id="102" value="Начало" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <!-- Create attempt -->
        <mxCell id="103" value="Создать запись о попытке&#xa;тестирования в базе данных" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="90" width="260" height="60" as="geometry" />
        </mxCell>
        <!-- Next question -->
        <mxCell id="104" value="Получить очередной ответ&#xa;пользователя" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="170" width="260" height="60" as="geometry" />
        </mxCell>
        <!-- Decision: more questions? -->
        <mxCell id="105" value="Есть ещё вопросы&#xa;в тесте?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="115" y="250" width="210" height="80" as="geometry" />
        </mxCell>
        <!-- Save answer and check -->
        <mxCell id="106" value="Сохранить ответ в таблице&#xa;user_answer и проверить&#xa;корректность" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="350" width="260" height="80" as="geometry" />
        </mxCell>
        <!-- Compute scores -->
        <mxCell id="107" value="Вычислить сырые баллы,&#xa;процент правильных ответов&#xa;и длительность попытки" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="460" width="260" height="80" as="geometry" />
        </mxCell>
        <!-- Save attempt summary -->
        <mxCell id="108" value="Обновить запись попытки&#xa;(баллы, процент, статус=finished)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="560" width="260" height="70" as="geometry" />
        </mxCell>
        <!-- Notify / pass to analytics -->
        <mxCell id="109" value="Передать результаты&#xa;для аналитики и преподавателю" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="650" width="260" height="70" as="geometry" />
        </mxCell>
        <!-- End -->
        <mxCell id="110" value="Конец" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="750" width="120" height="40" as="geometry" />
        </mxCell>
        <!-- Edges -->
        <mxCell id="120" edge="1" parent="1" source="102" target="103" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="121" edge="1" parent="1" source="103" target="104" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="122" edge="1" parent="1" source="104" target="105" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Yes: there are questions -> save answer & go back -->
        <mxCell id="123" value="Да" edge="1" parent="1" source="105" target="106" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="124" edge="1" parent="1" source="106" target="104" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- No: no more questions -->
        <mxCell id="125" value="Нет" edge="1" parent="1" source="105" target="107" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="126" edge="1" parent="1" source="107" target="108" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="127" edge="1" parent="1" source="108" target="109" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="128" edge="1" parent="1" source="109" target="110" style="endArrow=block;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
